{
  "name": "veritas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:prepare": "node scripts/prepare-parser-assets.mjs",
    "dev": "npm run assets:prepare && next dev",
    "build": "npm run assets:prepare && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs e2e/core",
    "test:real": "npm run build && node scripts/run-e2e.mjs e2e/real"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
